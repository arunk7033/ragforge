# Supabase project URL (Project Settings → API). Access tokens are verified against its JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only for projects still using the legacy shared JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
