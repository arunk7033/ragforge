# Copy to .env.local and fill in. Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI backend (server-side only).
BACKEND_URL=http://localhost:8000

# Landing site, linked from the logo on the login page.
NEXT_PUBLIC_SITE_URL=http://localhost:4321
