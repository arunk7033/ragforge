---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/Section.astro";
import { site } from "../data/site";

const inputClass =
  "w-full rounded-[14px] border border-dark bg-white px-6 py-4 text-lg placeholder:text-dark/40 focus:outline-none focus:ring-2 focus:ring-green";
---

<MainLayout title={`Log in — ${site.name}`} description={`Log in to your ${site.name} workspace.`} bare>
  <Section>
    <div class="grid gap-10 pb-20 lg:grid-cols-2">
      <div class="card flex flex-col gap-8 bg-gray p-8 sm:p-12">
        <div class="flex flex-col gap-3">
          <h1 class="text-4xl font-medium">Welcome <span class="greenhead">back</span></h1>
          <p class="text-lg">Log in to manage your pipelines, evaluations, and traces.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <a href={site.authEndpoint ? `${site.authEndpoint}/github` : "#"} class="btn-secondary gap-3 bg-white px-6 py-4" data-sso>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path>
            </svg>
            GitHub
          </a>
          <a href={site.authEndpoint ? `${site.authEndpoint}/sso` : "#"} class="btn-secondary gap-3 bg-white px-6 py-4" data-sso>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="10" width="16" height="11" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            </svg>
            Single sign-on
          </a>
        </div>

        <div class="flex items-center gap-4 text-sm uppercase tracking-[0.2em] text-dark/50">
          <span class="h-px flex-1 bg-dark/20"></span>or<span class="h-px flex-1 bg-dark/20"></span>
        </div>

        <form id="login-form" class="flex flex-col gap-5" method="post" action={site.authEndpoint || undefined}>
          <label class="flex flex-col gap-2">
            <span class="font-medium">Work email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" class={inputClass} />
          </label>
          <label class="flex flex-col gap-2">
            <span class="flex items-center justify-between font-medium">
              Password
              <a href={site.contact} class="text-sm font-normal underline underline-offset-4">Forgot password?</a>
            </span>
            <input type="password" name="password" autocomplete="current-password" required minlength="8" placeholder="••••••••" class={inputClass} />
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="remember" class="h-5 w-5 accent-dark" />
            Keep me logged in
          </label>
          <button type="submit" class="btn-primary mt-2 w-full">Log in</button>
          <p id="login-notice" class="hidden rounded-[14px] border border-dark bg-green px-5 py-4" role="status">
            Sign-in isn't connected yet. Set <code class="font-mono">authEndpoint</code> in
            <code class="font-mono">site/src/data/site.ts</code> to enable it.
          </p>
        </form>

        <p class="text-center text-lg">
          New to {site.name}? <a href={site.contact} class="underline underline-offset-4">Request access</a>
        </p>
      </div>

      <div class="hidden flex-col justify-between gap-10 rounded-card bg-dark p-12 text-white lg:flex">
        <span class="w-fit rounded-full border border-white/40 px-4 py-1.5 text-sm">Your RAG control plane</span>
        <ul class="flex flex-col gap-6 text-xl">
          {
            [
              "Monitor retrieval quality and answer faithfulness",
              "Inspect traces with cost, latency, and retrieved context",
              "Run evaluation suites before every release",
            ].map((item) => (
              <li class="flex gap-4">
                <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-green text-sm text-dark">✓</span>
                {item}
              </li>
            ))
          }
        </ul>
        <div class="grid grid-cols-3 gap-4">
          {
            [
              ["Faithfulness", "0.94"],
              ["p95 latency", "820ms"],
              ["Recall@5", "0.89"],
            ].map(([label, value]) => (
              <div class="rounded-[20px] border border-white/20 p-5">
                <div class="text-2xl font-medium text-green">{value}</div>
                <div class="mt-1 text-sm text-white/70">{label}</div>
              </div>
            ))
          }
        </div>
        <p class="text-sm text-white/50">Sample dashboard metrics for illustration.</p>
      </div>
    </div>
  </Section>
</MainLayout>

<script define:vars={{ configured: Boolean(site.authEndpoint) }}>
  if (!configured) {
    const notice = document.getElementById("login-notice");
    document.getElementById("login-form").addEventListener("submit", (event) => {
      event.preventDefault();
      notice.classList.remove("hidden");
    });
    document.querySelectorAll("[data-sso]").forEach((el) =>
      el.addEventListener("click", (event) => {
        event.preventDefault();
        notice.classList.remove("hidden");
      }),
    );
  }
</script>
