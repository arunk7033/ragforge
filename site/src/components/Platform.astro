---
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { site } from "../data/site";

type Variant = "gray" | "green" | "dark";

const features: { top: string; bottom: string; body: string; variant: Variant; icon: string }[] = [
  {
    top: "Ingestion &",
    bottom: "chunking",
    body: "PDFs, HTML, Markdown, and databases with structure-aware, semantic chunking.",
    variant: "gray",
    icon: "M8 6h22l10 10v26H8z M30 6v10h10 M14 24h20 M14 31h20 M14 38h12",
  },
  {
    top: "Hybrid",
    bottom: "retrieval",
    body: "Dense and sparse search fused with metadata filters for high recall.",
    variant: "green",
    icon: "M20 34a14 14 0 1 1 0-28 14 14 0 0 1 0 28z M30 30l12 12 M14 20h12 M20 14v12",
  },
  {
    top: "Reranking &",
    bottom: "generation",
    body: "Cross-encoder reranking and citation-grounded prompts across any LLM.",
    variant: "dark",
    icon: "M6 12h36 M6 24h26 M6 36h16 M36 30l6 6-6 6",
  },
  {
    top: "Evaluation",
    bottom: "suite",
    body: "Faithfulness, relevance, and recall metrics with regression gates in CI.",
    variant: "gray",
    icon: "M6 42h36 M10 42V28 M20 42V18 M30 42V24 M40 42V8",
  },
  {
    top: "Tracing &",
    bottom: "observability",
    body: "Every query traced end to end: latency, cost, tokens, and retrieved context.",
    variant: "green",
    icon: "M4 26h8l5-14 8 26 6-18 4 6h9",
  },
  {
    top: "Built to",
    bottom: "scale",
    body: "Async workers, caching, and horizontal scaling for production traffic.",
    variant: "dark",
    icon: "M8 40l12-12 8 8 14-18 M32 18h10v10",
  },
];

const bg: Record<Variant, string> = {
  gray: "bg-gray",
  green: "bg-green",
  dark: "bg-dark text-white",
};
---

<Section id="platform">
  <SectionTitle
    title="Platform"
    description="Everything you need to take a RAG prototype to a reliable production system, in one composable toolkit."
  />
  <div class="grid gap-10 md:grid-cols-2">
    {
      features.map((f) => (
        <article class={`card flex min-h-[310px] flex-col justify-between gap-8 p-8 sm:p-12 ${bg[f.variant]}`}>
          <div class="flex items-start justify-between gap-6">
            <h3 class="flex flex-col text-[28px] font-medium leading-[1.3] sm:text-3xl">
              <span class={`w-fit ${f.variant === "gray" ? "greenhead" : "whitehead"}`}>{f.top}</span>
              <span class={`w-fit ${f.variant === "gray" ? "greenhead" : "whitehead"}`}>{f.bottom}</span>
            </h3>
            <svg
              viewBox="0 0 48 48"
              class="h-16 w-16 shrink-0 sm:h-20 sm:w-20"
              fill="none"
              stroke={f.variant === "dark" ? "#b9ff66" : "#191a23"}
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={f.icon} />
            </svg>
          </div>
          <p class="max-w-[420px] text-lg">{f.body}</p>
          <a href={site.docs} class="flex w-fit items-center gap-4 text-lg" target="_blank" rel="noopener">
            <ArrowIcon variant={f.variant === "dark" ? "light" : "dark"} />
            <span>Learn more</span>
          </a>
        </article>
      ))
    }
  </div>
</Section>
