---
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";

const steps = [
  {
    title: "Connect your sources",
    body: "Point ragforge at file stores, databases, or web content. Connectors handle auth, incremental sync, and change detection.",
  },
  {
    title: "Parse & chunk",
    body: "Layout-aware parsing keeps tables, headings, and code blocks intact. Chunking strategies are configurable per source.",
  },
  {
    title: "Embed & index",
    body: "Generate embeddings with the model of your choice and index into your vector store alongside a sparse keyword index.",
  },
  {
    title: "Retrieve & rerank",
    body: "Hybrid search fuses dense and sparse results, then a reranker selects the most relevant context for each query.",
  },
  {
    title: "Generate grounded answers",
    body: "Prompts enforce citations to retrieved passages, reducing hallucinations and making every answer verifiable.",
  },
  {
    title: "Evaluate & monitor",
    body: "Run offline eval suites before every release and trace live traffic to catch quality regressions early.",
  },
];
---

<Section id="pipeline">
  <SectionTitle
    title="How it works"
    description="A transparent, six-stage pipeline. Swap any component without rewriting the rest."
  />
  <div class="flex flex-col gap-6 md:gap-8">
    {
      steps.map((step, i) => (
        <details class="card group bg-gray px-8 py-8 transition-colors open:bg-green sm:px-14 sm:py-10" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-6">
              <span class="text-3xl font-medium sm:text-6xl">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-lg font-medium sm:text-3xl">{step.title}</span>
            </span>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-dark bg-gray text-3xl leading-none sm:h-14 sm:w-14">
              <span class="group-open:hidden">+</span>
              <span class="hidden group-open:inline">−</span>
            </span>
          </summary>
          <div class="mt-8 border-t border-dark pt-8 text-lg">{step.body}</div>
        </details>
      ))
    }
  </div>
</Section>
