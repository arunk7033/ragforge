---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const links = [
  { href: "/#platform", label: "Platform" },
  { href: "/#use-cases", label: "Use cases" },
  { href: "/#pipeline", label: "How it works" },
  { href: site.github, label: "GitHub" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/90 backdrop-blur" id="site-header">
  <nav class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between px-5 py-5">
    <a href="/" aria-label="ragforge home"><Logo /></a>

    <button
      id="menu-toggle"
      class="lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="menu"
    >
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div id="menu" class="hidden w-full lg:flex lg:w-auto lg:items-center lg:gap-8">
      <ul class="mt-4 flex flex-col gap-4 text-lg lg:mt-0 lg:flex-row lg:gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:underline" data-close-menu>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:mt-0">
        <a href={site.login} class="btn-secondary w-full px-7 py-3.5 lg:w-auto" data-close-menu>Log in</a>
        <a href={site.contact} class="btn-primary w-full px-7 py-3.5 lg:w-auto" data-close-menu>Book a demo</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("menu")!;
  const header = document.getElementById("site-header")!;

  const setOpen = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
  };

  toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
  document.querySelectorAll("[data-close-menu]").forEach((el) => el.addEventListener("click", () => setOpen(false)));

  window.addEventListener("scroll", () => {
    header.classList.toggle("border-dark/10", window.scrollY > 8);
  });
</script>
